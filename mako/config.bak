[general]
font=JetBrains Mono Nerd Font 10
width=350
height=80
margin=2
padding=5
border-radius=24
border-size=2
border-color=#b4befeff
background-color=#1e1e2ecc
text-color=#cdd6f4ff
format=<b>%s</b>\n%b
markup=true
default-timeout=200

[icons]
icon-path=~/.local/share/icons/Honken-Hybrid
max-size=48
enable=true

[urgency=low]
background-color=#1e1e2eaa
text-color=#cdd6f4ff
border-color=#b4befeff

[urgency=normal]
background-color=#1e1e2eaa
text-color=#cdd6f4ff
border-color=#b4befeff

[urgency=critical]
background-color=#1e1e2eaa
text-color=#cdd6f4ff
border-color=#f38ba8ff

[animation]
enabled=true
type=slide
duration=50
