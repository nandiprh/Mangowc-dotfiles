# ~/.config/home-manager/modules/qt.nix
{ config, pkgs, lib, ... }:

{
  qt = {
    enable = true;
    platformTheme.name = "qtct";
    style.name = "Fluent-roundDark";
  };

  xdg.configFile = {
    "Kvantum/kvantum.kvconfig".text = ''
      [General]
      theme=Fluent-round
    '';

    "qt6ct/qt6ct.conf".text = ''
      [Appearance]
      style=Fluent-roundDark
      color_scheme_path=
      custom_palette=false
      icon_theme=Honken_Hybrid

      [Fonts]
      fixed="JetBrains Mono,11,-1,5,50,0,0,0,0,0"
      general="JetBrains Mono,11,-1,5,50,0,0,0,0,0"
    '';
  };

  home.sessionVariables = {
    QT_QPA_PLATFORMTHEME = lib.mkForce "qt6ct";
    QT_STYLE_OVERRIDE = "Fluent-roundDark";
  };

  systemd.user.sessionVariables = {
    QT_QPA_PLATFORMTHEME = lib.mkForce "qt6ct";
    QT_STYLE_OVERRIDE = lib.mkForce "Fluent-roundDark";
  };
}
